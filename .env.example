# Frontend Environment Variables Template
# Copy this file to .env or .env.local for local development

# Backend API Base URL (Without trailing slash)
# Local development: http://localhost:5001
# Production example: https://faasbay-theme-backend.onrender.com
VITE_API_URL=http://localhost:5001

# Razorpay public key id (must match the backend's RAZORPAY_KEY_ID)
VITE_RAZORPAY_KEY_ID=

# Optional: OpenAI API Key for AI Product Generation in Admin OS
VITE_OPENAI_API_KEY=

# Absolute site URL used for canonical/OG share-image tags (no trailing slash).
# Update this once the custom domain is live; defaults to the Netlify subdomain.
VITE_SITE_URL=https://faasbay.netlify.app
